// Optional JS: can be used later for interactions
console.log("Albukhr Dashboard Loaded");

// Example: highlight a project on hover
const projects = document.querySelectorAll(".project");
projects.forEach(project => {
  project.addEventListener("mouseover", () => {
    project.style.background = "#c0ffc0";
  });
  project.addEventListener("mouseout", () => {
    project.style.background = "#e0ffe0";
  });
});
